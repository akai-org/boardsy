# Default: treat files as text and normalize to LF
* text=auto eol=lf

# Explicit rules for common text file types (ensure LF)
.gitattributes text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.json5 text eol=lf
*.jsonc text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.mdx text eol=lf

# Mark typical binary files so Git doesn't attempt line-ending conversions
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.gz binary
*.tar.gz binary
*.tgz binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

# end
